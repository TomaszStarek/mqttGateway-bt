{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "BluetoothAutoPair": {
    "Enabled": false,
    "NamePatterns": [ "^CEM3-BT_\\d{6}S_BC$", "^CES_\\d{6}S_BC$", "^TE\\d{5}$" ],
    "ScanIntervalSeconds": 20,
    "IssueInquiry": false
  }
}
